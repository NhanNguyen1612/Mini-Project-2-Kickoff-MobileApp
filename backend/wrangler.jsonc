{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vku-room-booking-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vku-booking-db",
      "database_id": "YOUR_D1_DATABASE_ID_AFTER_CREATE"
    }
  ]
}
